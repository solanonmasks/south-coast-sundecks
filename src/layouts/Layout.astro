---
// The outer HTML shell: <head> tags, fonts, SEO and Google business info.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://southcoastsundecks.ca');
const ogImage = new URL('/og-image.jpg', site).href;
const canonical = new URL(Astro.url.pathname, site).href;

// LocalBusiness info that search engines read. Only facts from the client's site.
// (No email address: none was found on the current site.)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: 'South Coast Sundecks & Exteriors Ltd.',
  description,
  url: site.href,
  image: ogImage,
  telephone: '+1-604-921-9185',
  areaServed: ['North Shore', 'West Vancouver', 'North Vancouver', 'Vancouver', 'Burnaby', 'Lions Bay', 'Squamish'],
  address: { '@type': 'PostalAddress', addressLocality: 'North Shore', addressRegion: 'BC', addressCountry: 'CA' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Lets the CSS know JavaScript is on (used for scroll animations) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0C2C3F" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
